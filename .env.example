# Server & Environment Configuration
PORT=3000
NODE_ENV=production

# Application Hosting URL
# In AI Studio, APP_URL is automatically set to the Cloud Run URL.
APP_URL="http://localhost:3000"

# Practice Management Configuration
CLINIC_NAME="Luma Dental Studio"
CLINIC_TIMEZONE="America/Los_Angeles"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION"

# Optional External Transactional Email Integration (e.g. Resend / SendGrid / Postmark)
# Leave blank to use built-in logging and in-app notifications
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="appointments@lumadentalstudio.com"

# Optional External SMS Reminder Integration (e.g. Twilio)
# Leave blank to use built-in logging and in-app notifications
SMS_PROVIDER_ACCOUNT_SID=""
SMS_PROVIDER_AUTH_TOKEN=""
SMS_FROM_NUMBER=""

# Optional Payment Gateway Integration (Stripe / Square)
# Keep disabled by default unless booking deposits are enabled by clinic policy
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
